# Optional. Rule-driven browsing and all transactions work without a model.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Set CHROME_PATH if Google Chrome is not at this location.
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PORT=4173
# Optional public deployment origin, e.g. https://your-demo.example
PUBLIC_ORIGIN=
# Official FlyAI credential; server-side only. Real transactions are disabled.
FLYAI_API_KEY=
# Optional existing HTTPS proxy for Node.js fetch.
FLYAI_HTTPS_PROXY=
# Optional Booking.com Managed Affiliate credentials (ordinary guest login is insufficient).
BOOKING_AFFILIATE_ID=
BOOKING_DEMAND_API_KEY=
# Expedia Rapid partner credentials; adapter not yet enabled.
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=

# Step Plan example: https://api.stepfun.com/step_plan/v1, model step-3.5-flash
# Use LLM_* above. Never put credentials in browser storage or VITE_* variables.
# Amap Web Service key; JavaScript map keys/security codes are not used.
AMAP_WEB_SERVICE_KEY=
# RollingGo remote Streamable HTTP MCP, read-only tools only.
ROLLINGGO_API_KEY=
ROLLINGGO_MCP_URL=https://mcp.rollinggo.cn/mcp
# TypeSafe Jev: bounded evidence-priority suggestions; never authorizes payment.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional single-owner pilot access gate (12+ characters). Server-side only.
# Configure before sharing a deployment; this is not multi-user account authentication.
STAYPILOT_ACCESS_PASSWORD=
